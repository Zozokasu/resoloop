{
  "name": "resoloop-jsx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JSX authoring tool for resoloop schema-v1 apply documents",
  "bin": {
    "resoloop-jsx": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "default": "./dist/src/jsx-runtime.js"
    },
    "./draft": {
      "types": "./dist/src/draft.d.ts",
      "default": "./dist/src/draft.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "contract": "tsc -p tsconfig.json && node dist/scripts/contract.js"
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
