{
  "prototypes": {
    "uix.toggle": {
      "slot": { "key": "${key}", "name": "${key}" },
      "components": [
        { "key": "${key}-rect", "type": "[FrooxEngine]FrooxEngine.UIX.RectTransform", "fields": "${rect}" },
        { "key": "${key}-button", "type": "[FrooxEngine]FrooxEngine.UIX.Button", "fields": { "ColorDrivers": [], "SendSlotEvents": true } },
        { "key": "${key}-toggle", "type": "[FrooxEngine]FrooxEngine.ButtonToggle", "fields": { "TargetValue": "${state}" } }
      ]
    }
  }
}
